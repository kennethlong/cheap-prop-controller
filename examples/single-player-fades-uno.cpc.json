    {
      "id": "output-3",
      "name": "Creature",
      "pin": 5,
      "activeLow": false,
      "idleActive": false,
      "color": "#60a5fa"
    },
    {
      "id": "output-4",
      "name": "Spotlight",
      "pin": 4,
