  "triggers": [
    {
      "id": "approach",
      "name": "Approach",
      "kind": "button",
      "pin": 8,
      "echoPin": null,
      "activeLow": true,
      "pullup": true,
      "debounceMs": 100,
      "thresholdCm": 100,
      "hysteresisCm": 20
    },
    {
      "id": "scare",
      "name": "Scare",
      "kind": "button",
      "pin": 9,
      "echoPin": null,
      "activeLow": true,
      "pullup": true,
      "debounceMs": 100,
      "thresholdCm": 100,
      "hysteresisCm": 20
    },
    {
      "id": "reset",
      "name": "Reset",
      "kind": "button",
      "pin": 10,
      "echoPin": null,
      "activeLow": true,
      "pullup": true,
      "debounceMs": 100,
      "thresholdCm": 100,
      "hysteresisCm": 20
    }
  ],
  "audio": {
    "players": [
      {
        "id": "player-1",
        "kind": "dfplayer",
        "txPin": 2,
        "rxPin": 3
      }
    ],
    "ambientTrack": 1,
    "ambientVolume": 20,
    "keepAmbient": false,
    "fadeMs": 500,
    "tracks": [
      {
        "number": 1,
        "name": "Bench ambient"
      },
      {
        "number": 2,
        "name": "Bench approach"
      },
      {
        "number": 3,
        "name": "Bench scare"
      }
    ],
    "transitionMode": "fade-through",
    "fadeOutMs": 150,
    "fadeInMs": 350
  },
  "states": [
    {
      "id": "idle",
      "name": "Idle",
      "durationMs": 10000,
      "loopTimeline": true,
      "foregroundTrack": null,
      "volume": 25,
      "loopAudio": false,
      "events": [],
      "transitions": [
        {
          "triggerId": "reset",
          "targetStateId": "idle"
        },
        {
          "triggerId": "approach",
          "targetStateId": "approach"
        }
      ]
    },
    {
      "id": "approach",
      "name": "Approach",
      "durationMs": 10000,
      "loopTimeline": false,
      "foregroundTrack": 2,
      "volume": 25,
      "loopAudio": false,
      "events": [
        {
          "id": "approach-light",
          "outputId": "output-1",
          "startMs": 0,
          "endMs": 5000
        }
      ],
      "transitions": [
        {
          "triggerId": "reset",
          "targetStateId": "idle"
        },
        {
          "triggerId": "scare",
          "targetStateId": "scare"
        }
      ]
    },
    {
      "id": "scare",
      "name": "Scare",
      "durationMs": 30000,
      "loopTimeline": false,
      "foregroundTrack": 3,
      "volume": 25,
      "loopAudio": false,
      "events": [
        {
          "id": "scare-1",
          "outputId": "output-1",
          "startMs": 0,
          "endMs": 3000
        },
        {
          "id": "scare-2",
          "outputId": "output-2",
          "startMs": 500,
          "endMs": 1500
        },
        {
          "id": "scare-3",
          "outputId": "output-3",
          "startMs": 1000,
          "endMs": 5000
        },
        {
          "id": "scare-4",
          "outputId": "output-2",
          "startMs": 2500,
          "endMs": 3500
        },
        {
          "id": "scare-5",
          "outputId": "output-4",
          "startMs": 4000,
          "endMs": 10000
        },
        {
          "id": "scare-6",
          "outputId": "output-1",
          "startMs": 12000,
          "endMs": 16000
        }
      ],
      "transitions": [
        {
          "triggerId": "reset",
          "targetStateId": "idle"
        }
      ]
    }
  ]
}
